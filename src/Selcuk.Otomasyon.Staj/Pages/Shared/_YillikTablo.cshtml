@* Yıl ve staj türüne göre başvuru, onay ve tamamlanma sayıları (Yıllara göre takip, Özet). *@
@model IReadOnlyList<YillikStajSayisi>
@if (Model.Count == 0)
{
    <p>Bu dönem için kayıt yok.</p>
}
else
{
    <div class="tablo-kabi">
        <table class="tablo tablo-yigin yillik">
            <caption class="gorunmez">Yıl ve staj türüne göre sayılar</caption>
            <thead>
                <tr>
                    <th scope="col">Yıl ve staj türü</th>
                    <th scope="col" class="sayi">Başvuru</th>
                    <th scope="col" class="sayi">Onay</th>
                    <th scope="col" class="sayi">Tamamlanan</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var satir in Model)
                {
                    <tr>
                        <th scope="row" class="yigin-baslik">@satir.Yil, @StajOtomasyonu.TurAdi(satir.Tur)</th>
                        <td class="sayi" data-etiket="Başvuru:">@satir.Basvuru</td>
                        <td class="sayi" data-etiket="Onay:">@satir.Onay</td>
                        <td class="sayi" data-etiket="Tamamlanan:">@satir.Tamamlanan</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
