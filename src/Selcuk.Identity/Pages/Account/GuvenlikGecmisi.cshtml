@page
@model Selcuk.Identity.Pages.Account.GuvenlikGecmisiModel
@{
    ViewData["Title"] = "Güvenlik geçmişi";
    ViewData[Duzen.Ayar.Genislik] = "genis";
}
<h1>Güvenlik geçmişi</h1>
<p class="giris-metni">
    Hesabınla ilgili son @GuvenlikGecmisiModel.KayitSayisi güvenlik olayı. Tanımadığın bir giriş veya değişiklik
    görürsen şifreni değiştir ve sistem yöneticisine başvur.
</p>

@if (Model.Satirlar.Count == 0)
{
    <p>Henüz kayıt yok.</p>
}
else
{
    @* Dar ekranda her satır iki satırlık bir öğeye dönüşür (site.css); rol öznitelikleri tablo anlamını korur. *@
    <table class="gecmis" role="table">
        <caption class="gorunmez">Son güvenlik olayları, en yenisi üstte</caption>
        <thead role="rowgroup">
            <tr role="row">
                <th scope="col" role="columnheader">Zaman</th>
                <th scope="col" role="columnheader">Olay</th>
                <th scope="col" role="columnheader">Uygulama</th>
                <th scope="col" role="columnheader">IP</th>
            </tr>
        </thead>
        <tbody role="rowgroup">
            @foreach (var satir in Model.Satirlar)
            {
                <tr role="row">
                    <td role="cell" data-etiket="Zaman">@satir.Zaman</td>
                    <td role="cell" class="gecmis-olay">
                        @if (satir.Basarisiz)
                        {
                            <span class="etiket etiket-tehlike">@Html.Raw(Simge.Hata)Başarısız</span>
                        }
                        <span>@satir.Olay</span>
                    </td>
                    @if (satir.Uygulama is null)
                    {
                        <td role="cell" data-etiket="Uygulama" class="bos"><span aria-hidden="true">—</span><span class="gorunmez">yok</span></td>
                    }
                    else
                    {
                        <td role="cell" data-etiket="Uygulama">@satir.Uygulama</td>
                    }
                    <td role="cell" data-etiket="IP" class="mono">@(satir.IpAdresi ?? "bilinmiyor")</td>
                </tr>
            }
        </tbody>
    </table>
}
