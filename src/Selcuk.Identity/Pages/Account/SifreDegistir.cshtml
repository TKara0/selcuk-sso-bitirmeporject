@page
@model Selcuk.Identity.Pages.Account.SifreDegistirModel
@{
    ViewData["Title"] = "Şifre değiştir";
}
<section class="kart">
    <h1>Şifre değiştir</h1>
    <p class="aciklama">Şifreniz değişince diğer cihaz ve tarayıcılardaki oturumlarınız kapatılır; bu oturum açık kalır.</p>

    <form method="post" class="form">
        <div asp-validation-summary="ModelOnly" class="hata" role="alert"></div>

        <label asp-for="Input.MevcutSifre"></label>
        <input asp-for="Input.MevcutSifre" autocomplete="current-password" autofocus />
        <span asp-validation-for="Input.MevcutSifre" class="alan-hatasi"></span>

        <label asp-for="Input.YeniSifre"></label>
        <input asp-for="Input.YeniSifre" autocomplete="new-password" />
        <span asp-validation-for="Input.YeniSifre" class="alan-hatasi"></span>

        <label asp-for="Input.YeniSifreTekrar"></label>
        <input asp-for="Input.YeniSifreTekrar" autocomplete="new-password" />
        <span asp-validation-for="Input.YeniSifreTekrar" class="alan-hatasi"></span>

        <partial name="_SifrePolitikasi" />

        <div class="dugmeler">
            <button type="submit" class="dugme birincil">Şifreyi değiştir</button>
            <a class="dugme ikincil" asp-page="/Account/Hesabim">Vazgeç</a>
        </div>
    </form>
</section>
