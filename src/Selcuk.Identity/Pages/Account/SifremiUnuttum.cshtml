@page
@model Selcuk.Identity.Pages.Account.SifremiUnuttumModel
@{
    ViewData["Title"] = "Şifremi unuttum";
}
<section class="kart">
    <h1>Şifremi unuttum</h1>

    @if (Model.Gonderildi)
    {
        <p class="bilgi" role="status">@SifremiUnuttumModel.GonderildiMesaji</p>
        <p class="ipucu">Bağlantı @Model.Gecerlilik.TotalMinutes.ToString("0") dakika geçerlidir. E-posta gelmediyse bir süre sonra tekrar deneyin.</p>
        <a class="dugme ikincil" asp-page="/Account/Login">Giriş sayfasına dön</a>
    }
    else
    {
        <p class="aciklama">
            Kullanıcı adınızı, öğrenci numaranızı veya e-posta adresinizi yazın. Hesabınıza kayıtlı e-posta adresine
            şifre sıfırlama bağlantısı gönderilir.
        </p>

        <form method="post" class="form">
            <div asp-validation-summary="ModelOnly" class="hata" role="alert"></div>

            <label asp-for="Input.KullaniciAdiVeyaEposta"></label>
            <input asp-for="Input.KullaniciAdiVeyaEposta" type="text" autocomplete="username" autocapitalize="none"
                   spellcheck="false" autofocus />
            <span asp-validation-for="Input.KullaniciAdiVeyaEposta" class="alan-hatasi"></span>

            <button type="submit" class="dugme birincil">Bağlantı gönder</button>
        </form>

        <p class="ipucu"><a asp-page="/Account/Login">Giriş sayfasına dön</a></p>
    }
</section>
