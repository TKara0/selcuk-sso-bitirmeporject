@page
@model Selcuk.Identity.Pages.Account.IkiAdimDogrulamaModel
@{
    ViewData["Title"] = Model.YeniKodlar is not null ? "Kurtarma kodları" : "İki aşamalı doğrulama";
}
<h1>@ViewData["Title"]</h1>

<partial name="_FormHatalari" />

@if (Model.KurulumGerekli)
{
    <div class="bant bant-bilgi" role="status">
        @Html.Raw(Simge.Bilgi)
        <p>Rolün için iki aşamalı doğrulama zorunludur. Kurulumu tamamlamadan uygulamalara giremezsin.</p>
    </div>
}
@if (Model.UygulamaGerektiriyor && !Model.Etkin)
{
    <div class="bant bant-bilgi" role="status">
        @Html.Raw(Simge.Bilgi)
        <p>Bu uygulama iki aşamalı doğrulama gerektiriyor. Kurulumu tamamlayınca uygulamaya kaldığın yerden devam edersin.</p>
    </div>
}
else if (Model.Durum == "kapatildi" && !Model.Etkin)
{
    <div class="bant bant-bilgi" role="status">
        @Html.Raw(Simge.Bilgi)
        <p>İki aşamalı doğrulama kapatıldı. Diğer cihaz ve tarayıcılardaki oturumların kapatıldı.</p>
    </div>
}

@if (Model.YeniKodlar is not null)
{
    <div class="bant bant-bilgi" role="status">
        @Html.Raw(Simge.Onay)
        <p>
            @(Model.YeniAcildi ? "İki aşamalı doğrulama açıldı." : "Kurtarma kodların yenilendi.")
            Diğer cihaz ve tarayıcılardaki oturumların kapatıldı.
        </p>
    </div>

    <div class="bant bant-uyari" role="alert">
        @Html.Raw(Simge.Uyari)
        <p class="bant-baslik">Bu kodlar bir daha gösterilmeyecek. Güvenli bir yere kaydet.</p>
    </div>

    <p class="giris-metni">
        Telefonuna erişemezsen doğrulama kodu yerine bu kodlardan birini kullanırsın. Her kod bir kez geçer.
    </p>

    <ul class="kod-izgarasi" id="kurtarma-kodlari" aria-label="Kurtarma kodları">
        @foreach (var kod in Model.YeniKodlar)
        {
            <li><code>@kod</code></li>
        }
    </ul>

    <div class="dugmeler">
        <button type="button" class="dugme dugme-ikincil" data-kopyala="#kurtarma-kodlari"
                data-kopyala-mesaj="Kurtarma kodları panoya kopyalandı." hidden>
            @Html.Raw(Simge.Kopyala)<span data-etiket>Kopyala</span>
        </button>
        <button type="button" class="dugme dugme-ikincil" data-indir="#kurtarma-kodlari"
                data-dosya-adi="tek-sifre-giris-kurtarma-kodlari.txt"
                data-dosya-basligi="Selçuk Üniversitesi (Test) — Tek Şifre Giriş kurtarma kodları. Her kod bir kez kullanılabilir." hidden>
            @Html.Raw(Simge.Indir)<span>Metin dosyası olarak indir</span>
        </button>
    </div>

    <div class="dugmeler bolum">
        @if (Model.DevamAdresi is not null)
        {
            <a class="dugme dugme-ana" href="@Model.DevamAdresi">Kodları kaydettim, devam et</a>
        }
        else
        {
            <a class="dugme dugme-ana" asp-page="/Account/Hesabim">Kodları kaydettim</a>
        }
    </div>
}
else if (Model.Etkin)
{
    <dl class="tanimlar">
        <div>
            <dt>Durum</dt>
            <dd><span class="etiket">Açık</span></dd>
        </div>
        <div>
            <dt>Kalan kurtarma kodu</dt>
            <dd>@Model.KalanKodSayisi</dd>
        </div>
    </dl>
    <p class="giris-metni">Girişte şifrenle birlikte doğrulayıcı uygulamandaki kod istenir.</p>

    <section class="bolum" aria-labelledby="yenile-baslik">
        <h2 id="yenile-baslik">Kurtarma kodlarını yenile</h2>
        <p class="soluk">Eski kodların hepsi geçersiz olur, 10 yeni kod bir kez gösterilir.</p>
        <div class="panel">
            <form method="post" asp-page-handler="KodlariYenile" class="form">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="alan">
                    <label for="yenile-sifre">Mevcut şifre</label>
                    <input asp-for="Onay.Sifre" id="yenile-sifre" class="metin-alani" autocomplete="current-password" />
                </div>
                <div class="alan">
                    <label for="yenile-kod">Uygulamadaki 6 haneli kod</label>
                    <input asp-for="Onay.Kod" id="yenile-kod" class="metin-alani kod-alani" type="text"
                           inputmode="numeric" autocomplete="one-time-code" spellcheck="false" data-kod-alani />
                </div>
                <div class="dugmeler">
                    <button type="submit" class="dugme dugme-ana">Kodları yenile</button>
                </div>
            </form>
        </div>
    </section>

    <section class="bolum" aria-labelledby="kapat-baslik">
        <h2 id="kapat-baslik">İki aşamalı doğrulamayı kapat</h2>
        @if (Model.RolGerektiriyor)
        {
            <p class="soluk">Rolün için iki aşamalı doğrulama zorunludur, kapatamazsın.</p>
        }
        else
        {
            <p class="soluk">Kapatınca anahtarın, kurtarma kodların ve hatırlanan cihazların geçersiz olur.</p>
            <div class="panel">
                <form method="post" asp-page-handler="Kapat" class="form">
                    <div class="alan">
                        <label for="kapat-sifre">Mevcut şifre</label>
                        <input asp-for="Onay.Sifre" id="kapat-sifre" class="metin-alani" autocomplete="current-password" />
                    </div>
                    <div class="alan">
                        <label for="kapat-kod">Uygulamadaki 6 haneli kod</label>
                        <input asp-for="Onay.Kod" id="kapat-kod" class="metin-alani kod-alani" type="text"
                               inputmode="numeric" autocomplete="one-time-code" spellcheck="false" data-kod-alani />
                    </div>
                    <div class="dugmeler">
                        <button type="submit" class="dugme dugme-tehlikeli">İki aşamalı doğrulamayı kapat</button>
                    </div>
                </form>
            </div>
        }
    </section>
}
else if (Model.Anahtar is not null)
{
    <p class="giris-metni">Üç adımda kur. Kurulum bitince girişte şifrenle birlikte telefonundaki kod istenir.</p>

    <ol class="adimlar">
        <li>
            <h2 class="adim-baslik">Uygulamayı aç</h2>
            <p>
                Telefonunda bir doğrulayıcı uygulama aç (Google Authenticator, Microsoft Authenticator gibi). Yoksa önce
                uygulama mağazasından kur.
            </p>
        </li>
        <li>
            <h2 class="adim-baslik">QR kodu okut</h2>
            <div class="qr-blok">
                <img class="qr" src="@Model.QrKod" alt="Doğrulayıcı uygulama için QR kod" width="184" height="184" />
                <div class="qr-anahtar">
                    <p>Okutamıyorsan uygulamada yeni hesap ekleyip bu anahtarı elle gir:</p>
                    <code class="anahtar" id="anahtar">@Model.Anahtar</code>
                    <div class="dugmeler">
                        <button type="button" class="dugme dugme-ikincil" data-kopyala="#anahtar" data-bosluksuz
                                data-kopyala-mesaj="Anahtar panoya kopyalandı." hidden>
                            @Html.Raw(Simge.Kopyala)<span data-etiket>Kopyala</span>
                        </button>
                    </div>
                    <p class="ipucu">Hesap türü: zamana dayalı (TOTP), 6 hane, 30 saniye.</p>
                    <p class="ipucu"><a href="@Model.OtpauthUri">Bu cihazdaki doğrulayıcı uygulamada aç</a></p>
                </div>
            </div>
        </li>
        <li>
            <h2 class="adim-baslik">Kodu gir</h2>
            <form method="post" asp-page-handler="Etkinlestir" class="form">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="alan">
                    <label for="Etkinlestirme_Kod">Uygulamanın gösterdiği 6 haneli kod</label>
                    <input asp-for="Etkinlestirme.Kod" class="metin-alani kod-alani" type="text" inputmode="numeric"
                           autocomplete="one-time-code" spellcheck="false" data-kod-alani
                           aria-describedby="@(Html.FormHatasiVar() ? "form-hatasi" : null)" />
                </div>
                <div class="dugmeler">
                    <button type="submit" class="dugme dugme-ana">Kodu doğrula ve aç</button>
                </div>
            </form>
        </li>
    </ol>
}
else
{
    <p class="giris-metni">
        İki aşamalı doğrulama kapalı. Açarsan girişte şifrenle birlikte telefonundaki doğrulayıcı uygulamanın ürettiği
        6 haneli kod istenir. Şifren ele geçirilse bile hesabına giriş yapılamaz.
    </p>
    <form method="post" asp-page-handler="Baslat" class="form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="dugmeler">
            <button type="submit" class="dugme dugme-ana">Kurulumu başlat</button>
        </div>
    </form>
}
