@page
@model Selcuk.Identity.Pages.Account.EkDogrulamaModel
@{
    ViewData["Title"] = "Ek doğrulama";
    ViewData[Duzen.Ayar.Genislik] = "dar";
    var formHatasi = Html.FormHatasiVar() ? " form-hatasi" : "";
}
<h1>Ek doğrulama</h1>

<div class="bant bant-bilgi" role="status">
    @Html.Raw(Simge.Bilgi)
    <p>Bu uygulama iki aşamalı doğrulama gerektiriyor. Kodu doğrulayınca uygulamaya kaldığın yerden devam edersin.</p>
</div>

<partial name="_FormHatalari" />

<div class="panel">
    <form method="post" class="form">
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="alan">
            <label for="Input_Kod" id="kod-etiketi">Doğrulama kodu</label>
            <input asp-for="Input.Kod" class="metin-alani kod-alani" type="text" inputmode="numeric"
                   autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" autofocus data-kod-alani
                   aria-describedby="@("kod-ipucu kod-hatasi" + formHatasi)" aria-invalid="@Html.AlanHatali("Input.Kod")" />
            <p class="ipucu" id="kod-ipucu">
                Doğrulayıcı uygulamandaki 6 haneli kodu gir. Telefonun yanında değilse kurtarma kodlarından birini de
                yazabilirsin.
            </p>
            <span asp-validation-for="Input.Kod" id="kod-hatasi" class="alan-hatasi"></span>
            <div>
                <button type="button" class="dugme-baglanti" data-kod-modu="Input_Kod" data-etiket-id="kod-etiketi"
                        data-ipucu-id="kod-ipucu" data-etiket-kurtarma="Kurtarma kodu"
                        data-ipucu-kurtarma="Kurtarma kodları XXXXX-XXXXX biçimindedir, her biri bir kez kullanılır."
                        data-dugme-kurtarma="Doğrulama kodu kullan" hidden>Kurtarma kodu kullan</button>
            </div>
        </div>

        <button type="submit" class="dugme dugme-ana dugme-tam">Kodu doğrula ve devam et</button>
    </form>
</div>

<p><a href="/">Uygulamalarım'a dön</a></p>
