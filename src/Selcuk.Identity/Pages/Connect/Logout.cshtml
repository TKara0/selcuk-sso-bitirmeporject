@page "/connect/logout"
@model Selcuk.Identity.Pages.Connect.LogoutModel
@{
    ViewData["Title"] = "Çıkış yap";
    ViewData[Duzen.Ayar.Genislik] = "dar";
}
<div class="durum-sayfasi">
    <h1>Çıkış yap</h1>
    <p class="giris-metni">Oturumun kapanır ve tek şifreyle girdiğin uygulamalardan da çıkış yapılır.</p>

    <form method="post" asp-page="/Connect/Logout">
        @* end-session parametreleri (post_logout_redirect_uri, state, id_token_hint) korunur. *@
        @foreach (var parametre in Request.Query)
        {
            foreach (var deger in parametre.Value)
            {
                <input type="hidden" name="@parametre.Key" value="@deger" />
            }
        }
        <button type="submit" class="dugme dugme-ana">Çıkış yap</button>
    </form>
</div>
