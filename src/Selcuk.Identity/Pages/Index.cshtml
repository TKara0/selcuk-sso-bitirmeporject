@page
@model Selcuk.Identity.Pages.IndexModel
@{
    ViewData["Title"] = "Uygulamalarım";
    ViewData[Duzen.Ayar.Genislik] = "genis";
}
<h1 class="baslik-buyuk">Merhaba, @Model.Ad</h1>

@if (Model.Uygulamalar.Count == 0)
{
    <p class="giris-metni">Henüz erişebildiğin bir uygulama yok. Yetki için birim yöneticine başvur.</p>
}
else
{
    <p class="giris-metni">Bu uygulamalara şifre girmeden geçebilirsin.</p>

    <h2 class="gorunmez">Uygulamalarım</h2>
    <ul class="satirlar uygulamalar">
        @for (var i = 0; i < Model.Uygulamalar.Count; i++)
        {
            var uygulama = Model.Uygulamalar[i];
            <li>
                <span class="uygulama-simge@(uygulama.Vurgu is null ? "" : " uygulama-simge-" + uygulama.Vurgu)" aria-hidden="true">@uygulama.SimgeMetni</span>
                <div>
                    <p class="satir-baslik"><span id="uygulama-@i">@uygulama.Ad</span>
                        @if (uygulama.MfaGerekli)
                        {
                            <span class="etiket" title="Bu uygulamaya iki aşamalı doğrulanmış oturumla girilir">2FA gerekli</span>
                        }
                    </p>
                    <p class="ipucu">@uygulama.Aciklama</p>
                </div>
                <a class="dugme dugme-ikincil" href="@uygulama.GirisAdresi" aria-describedby="uygulama-@i">Aç</a>
            </li>
        }
    </ul>
}
