@page
@model Selcuk.Identity.Pages.IndexModel
@{
    ViewData["Title"] = "Uygulamalarım";
}
<section class="kart">
    <h1>Uygulamalarım</h1>
    <p class="aciklama">
        Oturumunuz açık: <strong>@User.Identity?.Name</strong>. Aşağıdaki uygulamalara şifre girmeden geçebilirsiniz.
    </p>

    @if (Model.Uygulamalar.Count == 0)
    {
        <p>Kayıtlı uygulama bulunmuyor.</p>
    }
    else
    {
        <ul class="uygulamalar">
            @foreach (var uygulama in Model.Uygulamalar)
            {
                <li>
                    <a class="uygulama" href="@uygulama.GirisAdresi">
                        <strong>@uygulama.Ad</strong>
                        <span>@uygulama.Aciklama</span>
                        <small>@uygulama.AnaSayfa</small>
                    </a>
                </li>
            }
        </ul>
    }

    <a class="dugme ikincil cikis" href="/connect/logout">Çıkış yap</a>
</section>
