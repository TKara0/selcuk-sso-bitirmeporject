@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@model string
@inject IOptions<IdentityOptions> IdentityAyarlari
@*
    Şifre kuralları Identity'nin şifre ayarlarından üretilir; politika değişirse liste de değişir. Model: izlenen şifre
    alanının id'si. selcuk.js kuralları yazarken denetler ve karşılananı işaretler (aria-live polite). Sunucu yine
    Identity ile doğrular.
*@
@{
    var politika = IdentityAyarlari.Value.Password;
    var kurallar = new List<(string Kural, int Deger, string Metin)>
    {
        ("uzunluk", politika.RequiredLength, $"En az {politika.RequiredLength} karakter"),
    };
    if (politika.RequireUppercase) { kurallar.Add(("buyuk", 0, "En az bir büyük harf")); }
    if (politika.RequireLowercase) { kurallar.Add(("kucuk", 0, "En az bir küçük harf")); }
    if (politika.RequireDigit) { kurallar.Add(("rakam", 0, "En az bir rakam")); }
    if (politika.RequireNonAlphanumeric) { kurallar.Add(("sembol", 0, "En az bir sembol")); }
    if (politika.RequiredUniqueChars > 1) { kurallar.Add(("farkli", politika.RequiredUniqueChars, $"En az {politika.RequiredUniqueChars} farklı karakter")); }
}
<div class="sifre-politikasi" id="sifre-kurallari">
    <p id="sifre-kurallari-baslik">Yeni şifren şunları içermeli:</p>
    <ul aria-labelledby="sifre-kurallari-baslik" aria-live="polite" data-sifre-politikasi="@Model">
        @foreach (var (kural, deger, metin) in kurallar)
        {
            <li data-kural="@kural" data-deger="@deger">
                <span class="simge-bos">@Html.Raw(Simge.Daire)</span>
                <span class="simge-tamam">@Html.Raw(Simge.Onay)</span>
                <span>@metin<span class="gorunmez" data-durum></span></span>
            </li>
        }
    </ul>
    <p class="ipucu">Başka sitelerde kullandığın bir şifreyi seçme.</p>
</div>
