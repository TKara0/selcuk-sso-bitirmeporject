@*
    Ortak düzen: üst çubuk (küçük kapı işareti veya uygulama simgesi, uygulama adı, sağda hesap menüsü yuvası),
    isteğe bağlı sekmeler, içerik ve alt bilgi.
    ViewData: Title, Duzen.Ayar.* (uygulama adı ve simgesi, genişlik, alt bilgi, giriş düzeninde kapı paneli metinleri).
    Bölümler: "Stiller" (uygulamanın kendi CSS'i), "HesapMenusu" (üst çubuğun sağı), "Sekmeler" (üst çubuğun altında;
    <nav class="sekmeler"><ul><li><a>…; gösterilecek sekme yoksa bölüm boş kalır); son ikisi giriş düzeninde
    gösterilmez. "AltBilgiEk": alt bilgi metninin yanına (ör. otomasyonlarda veri kaynağı rozeti).
*@
@{
    var uygulama = ViewData[Duzen.Ayar.UygulamaAdi] as string ?? "Tek Şifre Giriş";
    var simge = ViewData[Duzen.Ayar.UygulamaSimgesi] as string;
    var altBilgi = ViewData[Duzen.Ayar.AltBilgi] as string ?? Duzen.AltBilgi;
    var sayfa = ViewData["Title"] as string;
    var genislik = ViewData[Duzen.Ayar.Genislik] as string;
    var giris = genislik == "giris";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrEmpty(sayfa) ? uygulama : $"{sayfa} — {uygulama}")</title>
    <link rel="preload" href="~/_content/Selcuk.Arayuz/fonts/atkinson-hyperlegible-next-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/_content/Selcuk.Arayuz/css/selcuk.css" asp-append-version="true" />
    @await RenderSectionAsync("Stiller", required: false)
    <script src="~/_content/Selcuk.Arayuz/js/selcuk.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="atla" href="#icerik">İçeriğe geç</a>
    @if (giris)
    {
        IgnoreSection("HesapMenusu");
        if (IsSectionDefined("Sekmeler"))
        {
            IgnoreSection("Sekmeler");
        }

        <div class="giris-duzeni">
            <header class="kapi-paneli">
                @Html.Raw(KapiIsareti.Buyuk)
                <div>
                    <p class="kapi-adi">@ViewData[Duzen.Ayar.KapiBasligi]</p>
                    <p class="kapi-cumlesi">@ViewData[Duzen.Ayar.KapiCumlesi]</p>
                </div>
            </header>
            <div class="giris-sutunu">
                <main id="icerik" class="giris-icerik">
                    @RenderBody()
                </main>
                <footer class="alt-bilgi"><p>@altBilgi</p>@await RenderSectionAsync("AltBilgiEk", required: false)</footer>
            </div>
        </div>
    }
    else
    {
        <header class="ust-cubuk@(simge is null ? "" : " uygulama-cubugu")">
            <a class="marka" href="~/">
                @if (simge is null)
                {
                    @Html.Raw(KapiIsareti.Kucuk)
                }
                else
                {
                    <span class="uygulama-simgesi" aria-hidden="true">@simge</span>
                }
                <span>@uygulama</span>
                <span class="etiket etiket-notr">Test</span>
            </a>
            @await RenderSectionAsync("HesapMenusu", required: false)
        </header>
        @await RenderSectionAsync("Sekmeler", required: false)
        <main id="icerik" class="icerik@(genislik is "dar" or "genis" ? " icerik-" + genislik : "")@(simge is null ? "" : " uygulama-icerigi")">
            @RenderBody()
        </main>
        <footer class="alt-bilgi"><p>@altBilgi</p>@await RenderSectionAsync("AltBilgiEk", required: false)</footer>
    }
</body>
</html>
