@* Demo OBİS'in düzeni: ortak düzen (Selcuk.Arayuz) + uygulama adı, simgesi, sekmeler ve hesap menüsü. *@
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Ortam
@{
    Layout = "_SelcukDuzen";
    ViewData[Duzen.Ayar.UygulamaAdi] = "Demo OBİS";
    ViewData[Duzen.Ayar.UygulamaSimgesi] = "DO";
    ViewData[Duzen.Ayar.AltBilgi] = "Demo OBİS yalnızca test amaçlıdır, veriler uydurmadır. Giriş Tek Şifre Giriş Sistemi ile yapılır.";

    var gecerli = ViewContext.RouteData.Values["page"] as string;
    string? Gecerli(string sayfa) => gecerli == sayfa ? "page" : null;
}
@section Stiller {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}
@section HesapMenusu {
    <partial name="_IstemciHesapMenusu" model="@(new[] { new HesapMenusuBaglantisi("Profilim", Url.Page("/Profilim")!, gecerli == "/Profilim") })" />
}
@section Sekmeler {
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="sekmeler" aria-label="@ViewData[Duzen.Ayar.UygulamaAdi]">
            <ul>
                <li><a asp-page="/Index" aria-current="@Gecerli("/Index")">Ana sayfa</a></li>
                @if (User.IsInRole(Roller.Ogrenci))
                {
                    <li><a asp-page="/Notlarim" aria-current="@Gecerli("/Notlarim")">Notlarım</a></li>
                }
                @if (User.IsInRole(Roller.Akademisyen))
                {
                    <li><a asp-page="/DersYonetimi" aria-current="@Gecerli("/DersYonetimi")">Ders Yönetimi</a></li>
                }
                @if (Ortam.IsDevelopment())
                {
                    <li><a asp-page="/TokenInceleme" aria-current="@Gecerli("/TokenInceleme")">Token İnceleme</a></li>
                }
            </ul>
        </nav>
    }
}
@RenderBody()
