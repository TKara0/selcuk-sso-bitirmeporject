@page
@using Selcuk.Istemci.Ortak
@{
    ViewData["Title"] = "Giriş tamamlanamadı";
    ViewData[Duzen.Ayar.Genislik] = "dar";
    var erisimReddedildi = Request.Query["neden"] == GirisDonusHatasi.ErisimReddedildi;
}
<div class="durum-sayfasi">
    @Html.Raw(KapiIsareti.Kapali)
    <h1>Giriş tamamlanamadı</h1>
    @if (erisimReddedildi)
    {
        <p class="giris-metni">Uygulamaya erişim izni verilmedi.</p>
    }
    else
    {
        <p class="giris-metni">
            Giriş işlemi tamamlanamadı. Bu genellikle tarayıcıda geri tuşuna basıldığında ya da giriş sayfası uzun süre
            açık kaldığında olur.
        </p>
    }
    <a class="dugme dugme-ana tek-sifre-girisi" asp-page="/Giris">@Html.Raw(KapiIsareti.Kucuk)<span>Tekrar giriş yap</span></a>
</div>
