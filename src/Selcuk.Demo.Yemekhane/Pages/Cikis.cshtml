@page
@model Selcuk.Demo.Yemekhane.Pages.CikisModel
@{
    ViewData["Title"] = "Çıkış";
}
<section class="kart">
    <h1>Çıkış</h1>
    <p class="aciklama">
        Demo Yemekhane oturumunuz ve kimlik sunucusundaki oturumunuz kapatılacak. Aynı oturumla girdiğiniz
        diğer uygulamalardan da çıkış yapılır.
    </p>
    <form method="post">
        <button type="submit" class="dugme birincil">Çıkış yap</button>
    </form>
</section>
