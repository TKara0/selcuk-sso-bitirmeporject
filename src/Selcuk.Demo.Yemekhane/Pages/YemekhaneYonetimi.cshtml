@page
@model Selcuk.Demo.Yemekhane.Pages.YemekhaneYonetimiModel
@{
    ViewData["Title"] = "Yemekhane Yönetimi";
}
<h1>Yemekhane Yönetimi</h1>
<p class="giris-metni">Önümüzdeki iş günleri için günlük rezervasyon sayıları.</p>

<div class="tablo-kabi">
    <table class="tablo">
        <caption class="gorunmez">Günlük rezervasyon sayıları</caption>
        <thead>
            <tr>
                <th scope="col">Gün</th>
                <th scope="col">Tarih</th>
                <th scope="col" class="sayi">Rezervasyon</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (gun, sayi) in Model.Sayilar)
            {
                <tr>
                    <th scope="row">@gun.ToString("dddd", Takvim.Tr)</th>
                    <td>@gun.ToString("dd.MM.yyyy", Takvim.Tr)</td>
                    <td class="sayi"><strong>@sayi</strong></td>
                </tr>
            }
        </tbody>
    </table>
</div>
