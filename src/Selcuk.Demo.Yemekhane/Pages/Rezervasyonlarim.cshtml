@page
@model Selcuk.Demo.Yemekhane.Pages.RezervasyonlarimModel
@{
    ViewData["Title"] = "Rezervasyonlarım";
}
<h1>Rezervasyonlarım</h1>
<p class="giris-metni">Önümüzdeki iş günleri için öğle yemeği ayır veya iptal et (veriler bellekte tutulur).</p>

@if (Model.Bildirim is not null)
{
    @* Sayfa yüklendikten sonra canlı bölgeye de yazılır (selcuk.js, data-duyur): ekran okuyucu duyurur. *@
    <div class="bant bant-uygulama" data-duyur>
        @Html.Raw(Simge.Onay)
        <p>@Model.Bildirim</p>
    </div>
}

<ul class="satirlar rezervasyonlar">
    @foreach (var (gun, rezervasyonlu) in Model.Gunler)
    {
        var tarih = gun.ToString("yyyy-MM-dd");
        <li>
            <div class="rezervasyon-gunu">
                <p class="rezervasyon-gun-adi">@gun.ToString("dddd", Takvim.Tr)</p>
                <p class="ipucu">@gun.ToString("dd.MM.yyyy", Takvim.Tr)</p>
            </div>
            @if (rezervasyonlu)
            {
                <span class="etiket etiket-uygulama">@Html.Raw(Simge.Onay)Rezervasyonlu</span>
                <form method="post" asp-page-handler="Iptal">
                    <input type="hidden" name="gun" value="@tarih" />
                    <button type="submit" class="dugme dugme-ikincil">İptal et<span class="gorunmez">: @Takvim.Yaz(gun)</span></button>
                </form>
            }
            else
            {
                <span class="etiket etiket-notr">Rezervasyon yok</span>
                <form method="post" asp-page-handler="Ekle">
                    <input type="hidden" name="gun" value="@tarih" />
                    <button type="submit" class="dugme dugme-uygulama">Rezervasyon yap<span class="gorunmez">: @Takvim.Yaz(gun)</span></button>
                </form>
            }
        </li>
    }
</ul>
