<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Demo Yemekhane</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="ust">
        <a class="marka" href="/">Demo Yemekhane — test uygulaması</a>
        <nav class="menu">
            <a asp-page="/Index">Haftalık menü</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Rezervasyonlarim">Rezervasyonlarım</a>
                @if (User.IsInRole(Roller.Personel))
                {
                    <a asp-page="/YemekhaneYonetimi">Yemekhane Yönetimi</a>
                }
                <a asp-page="/Profilim">Profilim</a>
                <form method="post" asp-page="/Cikis" class="satir-ici">
                    <button type="submit" class="baglanti">Çıkış</button>
                </form>
            }
            else
            {
                <a asp-page="/Giris">Giriş yap</a>
            }
        </nav>
    </header>
    <main class="kap">
        @RenderBody()
    </main>
    <footer class="alt">Bu uygulama yalnızca test amaçlıdır; veriler uydurmadır.</footer>
</body>
</html>
