@* Demo Yemekhane'nin düzeni: ortak düzen (Selcuk.Arayuz) + uygulama adı, simgesi, sekmeler ve hesap menüsü. *@
@{
    Layout = "_SelcukDuzen";
    ViewData[Duzen.Ayar.UygulamaAdi] = "Demo Yemekhane";
    ViewData[Duzen.Ayar.UygulamaSimgesi] = "DY";
    ViewData[Duzen.Ayar.AltBilgi] = "Demo Yemekhane yalnızca test amaçlıdır, veriler uydurmadır. Giriş Tek Şifre Giriş Sistemi ile yapılır.";

    var gecerli = ViewContext.RouteData.Values["page"] as string;
    string? Gecerli(string sayfa) => gecerli == sayfa ? "page" : null;
}
@section Stiller {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}
@section HesapMenusu {
    <partial name="_IstemciHesapMenusu" model="@(new[] { new HesapMenusuBaglantisi("Profilim", Url.Page("/Profilim")!, gecerli == "/Profilim") })" />
}
@section Sekmeler {
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="sekmeler" aria-label="@ViewData[Duzen.Ayar.UygulamaAdi]">
            <ul>
                <li><a asp-page="/Index" aria-current="@Gecerli("/Index")">Haftalık menü</a></li>
                <li><a asp-page="/Rezervasyonlarim" aria-current="@Gecerli("/Rezervasyonlarim")">Rezervasyonlarım</a></li>
                @if (User.IsInRole(Roller.Personel))
                {
                    <li><a asp-page="/YemekhaneYonetimi" aria-current="@Gecerli("/YemekhaneYonetimi")">Yemekhane Yönetimi</a></li>
                }
            </ul>
        </nav>
    }
}
@RenderBody()
