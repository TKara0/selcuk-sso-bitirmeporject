# Metin dosyaları depoda LF ile saklanır; çalışma kopyasında işletim sisteminin satır sonu kullanılır.
* text=auto

*.cs       text diff=csharp
*.cshtml   text
*.csproj   text
*.json     text
*.md       text
*.css      text
*.html     text
*.xml      text
*.config   text

# Windows araçlarının beklediği satır sonları
*.sln      text eol=crlf
*.ps1      text eol=crlf
*.cmd      text eol=crlf
*.bat      text eol=crlf

# POSIX kabuk betikleri
*.sh       text eol=lf

# İkili dosyalar
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.pdf      binary
*.zip      binary
*.dll      binary
*.exe      binary
